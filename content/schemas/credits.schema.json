{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truenorth.app/schemas/credits.schema.json",
  "title": "Asset credits",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-3.0", "MIT", "Generated"] },
          "source": { "type": "string", "format": "uri" },
          "notes": { "type": "string" }
        },
        "required": ["path", "title", "author", "license", "source"],
        "additionalProperties": false
      }
    }
  },
  "required": ["assets"],
  "additionalProperties": false
}
