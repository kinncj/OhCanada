{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truenorth.app/schemas/question.schema.json",
  "title": "Question bank (one file per subject)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/subject"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "required": [
    "subject",
    "questions"
  ],
  "additionalProperties": false,
  "$defs": {
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q-[a-z]{2,3}-\\d{3}$"
        },
        "subject": {
          "$ref": "common.schema.json#/$defs/subject"
        },
        "text": {
          "$ref": "common.schema.json#/$defs/localizedText"
        },
        "answer": {
          "$ref": "common.schema.json#/$defs/localizedText"
        },
        "distractors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "$ref": "common.schema.json#/$defs/localizedText"
          }
        },
        "explanation": {
          "$ref": "common.schema.json#/$defs/localizedText"
        },
        "source": {
          "type": "string",
          "pattern": "^Discover Canada: .+"
        },
        "asOf": {
          "type": "string",
          "format": "date"
        },
        "volatile": {
          "type": "boolean"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "description": "Official IRCC Discover Canada chapter URL on canada.ca that supports the answer."
        }
      },
      "required": [
        "id",
        "subject",
        "text",
        "answer",
        "distractors",
        "source",
        "asOf",
        "volatile"
      ],
      "additionalProperties": false
    }
  }
}
