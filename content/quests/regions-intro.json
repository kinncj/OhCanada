{
  "$schema": "../schemas/quest.schema.json",
  "id": "regions-intro",
  "district": "regions",
  "type": "dialogue",
  "title": {
    "en": "Coast to Coast to Coast",
    "fr": "D'un océan à l'autre et à l'autre"
  },
  "summary": {
    "en": "Visit all five regions.",
    "fr": "Visitez les cinq régions."
  },
  "giverNpc": "npc-regions-1",
  "steps": [
    {
      "id": "talk",
      "kind": "talk",
      "npc": "npc-regions-1",
      "objective": {
        "en": "Talk to Ranger Aputik",
        "fr": "Parlez à la garde Aputik"
      },
      "dialogue": [
        {
          "speaker": "npc-regions-1",
          "text": {
            "en": "Glad you made it. Head to the lookout and I'll test what you know.",
            "fr": "Contente de vous voir. Rendez-vous au belvédère et je testerai vos connaissances."
          }
        }
      ]
    },
    {
      "id": "reach",
      "kind": "reach",
      "trigger": "regions-landmark",
      "objective": {
        "en": "Reach the lookout",
        "fr": "Rendez-vous au belvédère"
      }
    },
    {
      "id": "quiz",
      "kind": "answer",
      "questions": [
        "q-re-001",
        "q-re-002",
        "q-re-003"
      ],
      "minCorrect": 2,
      "objective": {
        "en": "Answer three questions (2 of 3 to pass)",
        "fr": "Répondez à trois questions (2 sur 3 pour réussir)"
      }
    }
  ],
  "reward": {
    "stamp": "stamp-regions-intro"
  },
  "completionDialogue": [
    {
      "speaker": "npc-regions-1",
      "text": {
        "en": "Well done. Another stamp for your passport!",
        "fr": "Bravo. Un autre timbre pour votre passeport!"
      }
    }
  ]
}
