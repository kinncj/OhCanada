  "territory": {
    "nations": [
      "Mi'kmaq"
    ],
    "statement": {
      "en": "Halifax is in Mi'kma'ki, the territory of the Mi'kmaq. The Peace and Friendship Treaties signed on this coast are not like the treaties signed later in other parts of Canada. They did not give up the land, or the right to use it.",
      "fr": "Halifax se trouve au Mi'kma'ki, le territoire des Mi'kmaq. Les traités de paix et d'amitié signés sur cette côte ne ressemblent pas aux traités signés plus tard ailleurs au Canada. Ils n'ont pas cédé les terres, ni le droit de les utiliser."
    },
    "fact": {
      "factual": true,
      "source": {
        "sourceId": "cirnac-peace-and-friendship-treaties",
        "chapter": "Why are Peace and Friendship Treaties different than other historic treaties in Canada?",
        "url": "https://www.rcaanc-cirnac.gc.ca/eng/1100100028589/1539608999656",
        "sourceHash": "2497a7462458b6a0f90acb427b87b05d628bec33627a048c2f7558d0b3bd655e",
        "asOf": "2026-09-08T00:00:00Z",
        "volatile": false,
        "quote": "Unlike later treaties signed in other parts of Canada, the Peace and Friendship Treaties did not involve First Nations surrendering rights to the lands and resources they had traditionally used and occupied."
      },
