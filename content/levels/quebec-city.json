  "territory": {
    "nations": [
      "Huron-Wendat"
    ],
    "statement": {
      "en": "The Huron-Wendat Nation calls its customary territory Nionwentsïo. It follows both shores of the St. Lawrence River, between the Saint-Maurice and the Saguenay. The Nation's reserve, Wendake, sits inside the boundaries of Québec City.",
      "fr": "La Nation huronne-wendat appelle son territoire coutumier le Nionwentsïo. Il longe les deux rives du fleuve Saint-Laurent, entre la Saint-Maurice et le Saguenay. La réserve de la Nation, Wendake, se trouve à l'intérieur des limites de la ville de Québec."
    },
    "fact": {
      "factual": true,
      "source": {
        "sourceId": "huron-wendat-nionwentsio-brief-2016",
        "chapter": "PART I — PRESENTATION AND HISTORY OF THE HURON-WENDAT NATION",
        "page": 4,
        "url": "https://www.ourcommons.ca/Content/Committee/421/TRAN/Brief/BR8708093/br-external/HuronWendatFirstNationCouncil-9505010-e.pdf",
        "sourceHash": "367d7d1ee559569d1ec5b5ac349c167dfe275faeebb13500c328fefdf77f53d2",
        "asOf": "2026-09-08T00:00:00Z",
        "volatile": false,
        "quote": "The Wendake reserve is located in the administrative region of the Quebec national capital and is within the boundaries of the City of Quebec, which makes the Huron-Wendat Nation one of the most urbanized aboriginal nations in Quebec."
      },
