          "model": "",
          "checkedAt": null,
          "sourceHash": "",
          "evidence": ""
        }
      }
    },
    {
      "id": "e8-choose-a-candidate-and-a-party",
      "text": {
        "en": "In each electoral district, people vote for the candidate and the political party they prefer.",
        "fr": "Dans chaque circonscription, les gens votent pour le candidat et le parti politique qu'ils préfèrent."
