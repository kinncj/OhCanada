        "fr": "Tout citoyen canadien âgé de 18 ans ou plus peut se présenter à une élection fédérale."
      },
      "fact": {
        "factual": true,
        "source": {
          "sourceId": "discover-canada",
          "chapter": "Federal Elections",
          "page": 60,
          "url": "https://www.canada.ca/en/immigration-refugees-citizenship/corporate/publications-manuals/discover-canada.html",
          "sourceHash": "fd51046981916115cc39b989e9eedd3ab2c5943aeb7e0fe4e237e13a0da7c836",
          "asOf": "2026-09-08T00:00:00Z",
          "volatile": true,
          "quote": "Canadian citizens who are 18 years old or older may run in a federal election."
        },
        "verification": {
          "status": "unverified",
          "model": "",
          "checkedAt": null,
          "sourceHash": "",
          "evidence": ""
        }
      }
    },
    {
