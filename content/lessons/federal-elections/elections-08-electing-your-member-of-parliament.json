          "asOf": "2026-09-08T00:00:00Z",
          "volatile": true,
          "quote": "The people who run for office are called candidates."
        },
        "verification": {
          "status": "unverified",
          "model": "",
          "checkedAt": null,
          "sourceHash": "",
          "evidence": ""
        }
      }
    },
    {
      "id": "e8-many-candidates-in-a-district",
      "text": {
