          "sourceHash": "fd51046981916115cc39b989e9eedd3ab2c5943aeb7e0fe4e237e13a0da7c836",
          "asOf": "2026-09-09T00:00:00Z",
          "volatile": false,
          "quote": "Canada is the second largest country on earth—10 million square kilometres."
