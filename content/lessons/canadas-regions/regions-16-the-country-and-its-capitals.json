      "id": "r16-three-oceans",
      "text": {
        "en": "Canada touches three oceans. The Pacific is on the west, the Atlantic is on the east, and the Arctic is to the north.",
        "fr": "Le Canada est bordé par trois océans. Le Pacifique est à l'ouest, l'Atlantique à l'est et l'Arctique au nord."
      },
      "fact": {
        "factual": true,
        "source": {
          "sourceId": "discover-canada",
          "chapter": "Canada's Regions",
          "page": 93,
          "url": "https://www.canada.ca/en/immigration-refugees-citizenship/corporate/publications-manuals/discover-canada.html",
          "sourceHash": "fd51046981916115cc39b989e9eedd3ab2c5943aeb7e0fe4e237e13a0da7c836",
          "asOf": "2026-09-09T00:00:00Z",
          "volatile": false,
          "quote": "Three oceans line Canada’s frontiers: the Pacific Ocean in the west, the Atlantic Ocean in the east, and the Arctic Ocean to the north."
        },
        "verification": {
          "status": "unverified",
          "model": "",
          "checkedAt": null,
          "sourceHash": "",
          "evidence": ""
        }
      }
    },
