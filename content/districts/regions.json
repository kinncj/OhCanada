  "npcs": [
    {
      "id": "npc-regions-1",
      "name": {
        "en": "Ranger Aputik",
        "fr": "La garde Aputik"
      },
      "position": [
        3,
        0,
        12
      ],
      "behavior": "idle",
      "questRefs": [
        "regions-intro",
        "regions-five-regions-tour"
      ],
      "idleDialogue": {
        "en": "The three territories cover about a third of Canada's land, yet very few people live there. In summer the sun barely sets.",
        "fr": "Les trois territoires couvrent environ le tiers du territoire canadien, mais très peu de gens y vivent. L'été, le soleil se couche à peine."
      },
      "appearance": {
        "skinTone": "tone-3",
        "outfit": "parka",
        "hair": "long",
        "hairColor": "black",
        "accessory": "scarf",
        "body": "female",
        "age": "adult",
        "outfitStyle": "parka",
        "bottomColor": "#2b2f3a",
        "hat": "hood"
      }
    },
    {
      "id": "npc-regions-2",
      "name": {
        "en": "Mary MacLeod, Fisher",
        "fr": "Mary MacLeod, pêcheuse"
      },
      "position": [
        470,
        0,
        128
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "Back home the Bay of Fundy has the highest tides in the world. Atlantic Canada is four provinces, and Quebec is not one of them, whatever the map looks like.",
        "fr": "Chez nous, la baie de Fundy a les plus hautes marées du monde. Le Canada atlantique compte quatre provinces, et le Québec n'en fait pas partie, quoi qu'en dise la carte."
      },
      "appearance": {
        "skinTone": "tone-1",
        "outfit": "raincoat",
        "hair": "short",
        "hairColor": "red",
        "body": "female",
        "age": "adult",
        "outfitStyle": "raincoat",
        "bottomColor": "#23303d",
        "hat": "captain"
      }
    },
    {
      "id": "npc-regions-3",
      "name": {
        "en": "Simon Leblanc, Geographer",
        "fr": "Simon Leblanc, géographe"
      },
      "position": [
        14,
        0,
        20
      ],
      "behavior": "wander",
      "wanderRadius": 4,
      "questRefs": [],
      "idleDialogue": {
        "en": "Ontario and Quebec make up Central Canada, and more than half of all Canadians live there. Victoria, not Vancouver, is the capital of British Columbia.",
        "fr": "L'Ontario et le Québec forment le Canada central, où vivent plus de la moitié des Canadiens. Victoria, et non Vancouver, est la capitale de la Colombie-Britannique."
      },
      "appearance": {
        "skinTone": "tone-2",
        "outfit": "fleece",
        "hair": "short",
        "hairColor": "brown",
        "accessory": "backpack",
        "body": "male",
        "age": "adult",
        "outfitStyle": "casual",
        "bottomColor": "#4a3b2e",
        "hat": "cap",
        "beard": true
      }
    },
    {
      "id": "regions-fundy-lighthouse-keeper",
      "name": {
        "en": "Mabel Crosby, lighthouse keeper",
        "fr": "Mabel Crosby, gardienne de phare"
      },
      "position": [
        410,
        0,
        -28
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "Atlantic Canada is four provinces: Newfoundland and Labrador, Prince Edward Island, Nova Scotia and New Brunswick. Nova Scotia is the largest of them, and the Bay of Fundy has the highest tides in the world.",
        "fr": "Le Canada atlantique compte quatre provinces : Terre-Neuve-et-Labrador, l'Île-du-Prince-Édouard, la Nouvelle-Écosse et le Nouveau-Brunswick. La Nouvelle-Écosse est la plus grande, et la baie de Fundy a les plus hautes marées du monde."
      },
      "appearance": {
        "skinTone": "tone-1",
        "outfit": "raincoat",
        "hair": "short",
        "hairColor": "grey",
        "body": "female",
        "age": "elder",
        "outfitStyle": "raincoat",
        "bottomColor": "#2c3542",
        "hat": "captain"
      }
    },
    {
      "id": "regions-prairie-grain-farmer",
      "name": {
        "en": "Olaf Bergstrom, grain farmer",
        "fr": "Olaf Bergstrom, céréaliculteur"
      },
      "position": [
        -318,
        0,
        -292
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "Saskatchewan is called the breadbasket of the world and the wheat province. Alberta has the most cattle in Canada, and Manitoba's economy runs on farming, mining and hydro power.",
        "fr": "La Saskatchewan est surnommée le grenier du monde et la province du blé. L'Alberta compte le plus grand nombre de bovins au Canada, et l'économie du Manitoba repose sur l'agriculture, les mines et l'hydroélectricité."
      },
      "appearance": {
        "skinTone": "tone-2",
        "outfit": "plaid",
        "hair": "short",
        "hairColor": "blond",
        "body": "male",
        "age": "adult",
        "outfitStyle": "workwear",
        "bottomColor": "#3b4a6b",
        "hat": "cap",
        "beard": true
      }
    },
    {
      "id": "regions-west-coast-fisher",
      "name": {
        "en": "Kenji Nakamura, fisher",
        "fr": "Kenji Nakamura, pêcheur"
      },
      "position": [
        -430,
        0,
        108
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "Vancouver is Canada's largest and busiest port. British Columbia lives on forestry, mining, fishing, fruit orchards and wine, and about half of the goods it makes are forestry products.",
        "fr": "Vancouver est le port le plus grand et le plus achalandé du Canada. La Colombie-Britannique vit de la forêt, des mines, de la pêche, des vergers et du vin, et environ la moitié de ses produits proviennent de la forêt."
      },
      "appearance": {
        "skinTone": "tone-3",
        "outfit": "raincoat",
        "hair": "short",
        "hairColor": "black",
        "body": "male",
        "age": "adult",
        "outfitStyle": "raincoat",
        "bottomColor": "#24313f",
        "hat": "hood"
      }
    },
    {
      "id": "regions-inuit-hunter",
      "name": {
        "en": "Panigusiq, hunter",
        "fr": "Panigusiq, chasseur"
      },
      "position": [
        14,
        0,
        -490
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "Inuit means 'the people' in Inuktitut. We live in small, scattered communities across the Arctic, and our knowledge of the land, sea and wildlife has been passed down for generations. This qamutiik is how we travel over the snow.",
        "fr": "Inuit signifie « le peuple » en inuktitut. Nous vivons dans de petites communautés dispersées à travers l'Arctique, et notre connaissance de la terre, de la mer et de la faune se transmet de génération en génération. Ce qamutiik nous sert à voyager sur la neige."
      },
      "appearance": {
        "skinTone": "tone-4",
        "outfit": "parka",
        "hair": "short",
        "hairColor": "black",
        "body": "male",
        "age": "adult",
        "outfitStyle": "parka",
        "bottomColor": "#3a3128",
        "hat": "hood"
      }
    },
    {
      "id": "regions-quebec-habitant",
      "name": {
        "en": "Jean-Baptiste Gagnon, habitant",
        "fr": "Jean-Baptiste Gagnon, habitant"
      },
      "position": [
        318,
        0,
        -448
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "Quebec is the largest province by area and the heart of French-speaking Canada. Our ancestors farmed the long strips along the St. Lawrence in the 1600s; today the river is a seaway that carries ships from the Great Lakes to the Atlantic.",
        "fr": "Le Québec est la plus grande province par sa superficie et le cœur du Canada francophone. Nos ancêtres cultivaient les longues terres le long du Saint-Laurent dès les années 1600; aujourd'hui, le fleuve est une voie maritime qui mène les navires des Grands Lacs à l'Atlantique."
      },
      "appearance": {
        "skinTone": "tone-2",
        "outfit": "plaid",
        "hair": "short",
        "hairColor": "brown",
        "accessory": "scarf",
