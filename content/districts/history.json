  "npcs": [
    {
      "id": "npc-history-1",
      "name": {
        "en": "Marie, Fur-Trade Historian",
        "fr": "Marie, historienne de la traite des fourrures"
      },
      "position": [
        3,
        0,
        12
      ],
      "behavior": "idle",
      "questRefs": [
        "history-intro",
        "history-in-order-of-events",
        "history-the-fur-trade-ledger"
      ],
      "idleDialogue": {
        "en": "Samuel de Champlain built his fortress at Quebec in 1608. Fur, above all beaver pelts, was the trade that kept New France alive.",
        "fr": "Samuel de Champlain a bâti sa forteresse à Québec en 1608. La fourrure, surtout les peaux de castor, était le commerce qui faisait vivre la Nouvelle-France."
      },
      "appearance": {
        "skinTone": "tone-2",
        "outfit": "plaid",
        "hair": "long",
        "hairColor": "auburn",
        "body": "female",
        "age": "adult",
        "outfitStyle": "workwear",
        "bottomColor": "#3a2c1e",
        "hat": "beret"
      }
    },
    {
      "id": "npc-history-2",
      "name": {
        "en": "Sergeant Baptiste, Fort Guard",
        "fr": "Le sergent Baptiste, garde du fort"
      },
      "position": [
        -12,
        0,
        22
      ],
      "behavior": "patrol",
      "wanderRadius": 6,
      "questRefs": [],
      "idleDialogue": {
        "en": "In 1813, at Châteauguay, de Salaberry and a few hundred mostly French-Canadian soldiers turned back an American army many times their size.",
        "fr": "En 1813, à Châteauguay, de Salaberry et quelques centaines de soldats, surtout canadiens-français, ont repoussé une armée américaine bien plus nombreuse."
      },
      "appearance": {
        "skinTone": "tone-3",
        "outfit": "parka",
        "hair": "short",
        "hairColor": "black",
        "body": "male",
        "age": "adult",
        "outfitStyle": "uniform",
        "bottomColor": "#1d2430",
        "hat": "cap",
        "beard": true
      }
    },
    {
      "id": "npc-history-3",
      "name": {
        "en": "Grandmother Adèle, Métis Storyteller",
        "fr": "Grand-mère Adèle, conteuse métisse"
      },
      "position": [
        14,
        0,
        20
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "Louis Riel led our people twice and many call him the father of Manitoba. History is told differently depending on who is telling it.",
        "fr": "Louis Riel a dirigé notre peuple à deux reprises et beaucoup le considèrent comme le père du Manitoba. L'histoire se raconte différemment selon qui la raconte."
      },
      "appearance": {
        "skinTone": "tone-4",
        "outfit": "plaid",
        "hair": "long",
        "hairColor": "grey",
        "accessory": "scarf",
        "body": "female",
        "age": "elder",
        "outfitStyle": "casual",
        "bottomColor": "#3b2f2a",
        "hat": "none"
      }
    },
    {
      "id": "history-voyageur",
      "name": {
        "en": "Étienne, voyageur",
        "fr": "Étienne, voyageur"
      },
      "position": [
        66,
        0,
        -78
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "We paddled the fur brigades for the Hudson's Bay Company, which got exclusive trading rights over the whole Hudson Bay watershed in 1670, and for its rival, the North West Company. A canoe like this carried tonnes of beaver pelts.",
        "fr": "Nous pagayions pour les brigades de fourrures de la Compagnie de la Baie d'Hudson, qui a obtenu en 1670 le monopole du commerce sur tout le bassin de la baie d'Hudson, et pour sa rivale, la Compagnie du Nord-Ouest. Un canot comme celui-ci transportait des tonnes de peaux de castor."
      },
      "appearance": {
        "skinTone": "tone-2",
        "outfit": "plaid",
        "hair": "long",
        "hairColor": "auburn",
        "accessory": "scarf",
        "body": "male",
        "age": "adult",
        "outfitStyle": "workwear",
        "bottomColor": "#4a3421",
        "hat": "toque",
        "beard": true
      }
    },
    {
      "id": "history-wwi-soldier",
      "name": {
        "en": "Private Callaghan, Canadian Corps",
        "fr": "Le soldat Callaghan, Corps canadien"
      },
      "position": [
        326,
        0,
        -270
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "In April 1917 the four divisions of the Canadian Corps fought together for the first time and took Vimy Ridge. More than 600,000 Canadians served in the First World War; April 9 is Vimy Day.",
        "fr": "En avril 1917, les quatre divisions du Corps canadien ont combattu ensemble pour la première fois et ont pris la crête de Vimy. Plus de 600 000 Canadiens ont servi pendant la Première Guerre mondiale; le 9 avril est le jour de Vimy."
      },
      "appearance": {
        "skinTone": "tone-1",
        "outfit": "parka",
        "hair": "buzz",
        "hairColor": "brown",
        "body": "male",
        "age": "young",
        "outfitStyle": "uniform",
        "bottomColor": "#4b4a33",
        "hat": "hardhat"
      }
    },
    {
      "id": "history-loyalist",
      "name": {
        "en": "Abigail Perley, Loyalist settler",
        "fr": "Abigail Perley, colonne loyaliste"
      },
      "position": [
        -114,
        0,
        292
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "After the American Revolution more than 40,000 of us who stayed loyal to the Crown came north to Nova Scotia and Quebec. We cleared these farms and started new towns; it was a hard first winter.",
        "fr": "Après la Révolution américaine, plus de 40 000 d'entre nous, restés fidèles à la Couronne, sont venus vers le nord, en Nouvelle-Écosse et au Québec. Nous avons défriché ces fermes et fondé de nouveaux villages; le premier hiver a été dur."
      },
      "appearance": {
        "skinTone": "tone-2",
        "outfit": "fleece",
        "hair": "bun",
        "hairColor": "blond",
        "body": "female",
        "age": "adult",
        "outfitStyle": "casual",
        "bottomColor": "#5a4632",
        "hat": "none"
      }
    }
