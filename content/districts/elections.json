  "npcs": [
    {
      "id": "npc-elections-1",
      "name": {
        "en": "Fatima, Returning Officer",
        "fr": "Fatima, directrice du scrutin"
      },
      "position": [
        3,
        0,
        12
      ],
      "behavior": "idle",
      "questRefs": [
        "elections-intro",
        "elections-your-voter-information-card"
      ],
      "idleDialogue": {
        "en": "To vote federally you must be a Canadian citizen, at least 18 on election day, and on the voters' list. Everything else, we can sort out here.",
        "fr": "Pour voter au fédéral, il faut être citoyen canadien, avoir au moins 18 ans le jour du vote et figurer sur la liste électorale. Le reste, on peut le régler ici."
      },
      "appearance": {
        "skinTone": "tone-4",
        "outfit": "parka",
        "hair": "bun",
        "hairColor": "black",
        "accessory": "glasses",
        "body": "female",
        "age": "adult",
        "outfitStyle": "formal",
        "bottomColor": "#1f2430",
        "hat": "none"
      }
    },
    {
      "id": "npc-elections-2",
      "name": {
        "en": "Marco, Deputy Returning Officer",
        "fr": "Marco, scrutateur"
      },
      "position": [
        -232,
        0,
        -46
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "When the polls close, we count every paper ballot by hand, with witnesses from the candidates watching. No machines, no secrets.",
        "fr": "À la fermeture des bureaux, nous comptons chaque bulletin papier à la main, sous le regard de témoins des candidats. Ni machines, ni secrets."
      },
      "appearance": {
        "skinTone": "tone-2",
        "outfit": "fleece",
        "hair": "short",
        "hairColor": "grey",
        "body": "male",
        "age": "elder",
        "outfitStyle": "casual",
        "bottomColor": "#3a3f4a",
        "hat": "none",
        "beard": true
      }
    },
    {
      "id": "npc-elections-3",
      "name": {
        "en": "Sophie Lavoie, Candidate",
        "fr": "Sophie Lavoie, candidate"
      },
      "position": [
        14,
        0,
        20
      ],
      "behavior": "wander",
      "wanderRadius": 5,
      "questRefs": [],
      "idleDialogue": {
        "en": "Any citizen aged 18 or over can run for Parliament, with a party or as an independent. Whoever gets the most votes in the riding wins the seat.",
        "fr": "Tout citoyen de 18 ans ou plus peut se présenter au Parlement, avec un parti ou comme indépendant. Celui qui obtient le plus de votes dans la circonscription remporte le siège."
      },
      "appearance": {
        "skinTone": "tone-1",
        "outfit": "plaid",
        "hair": "long",
        "hairColor": "blond",
        "body": "female",
        "age": "adult",
        "outfitStyle": "formal",
        "bottomColor": "#2a2f3a",
        "hat": "none"
      }
    },
    {
      "id": "elections-officer",
      "name": {
        "en": "Ayesha Khan, Elections officer",
        "fr": "Ayesha Khan, agente électorale"
      },
      "position": [
        -152,
        0,
        292
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "You can vote on election day, at an advance poll, or by mail with a special ballot. Bring your voter information card and proof of identity, and remember: your ballot is secret, nobody may ask how you voted.",
        "fr": "Vous pouvez voter le jour de l'élection, à un bureau de vote par anticipation ou par la poste avec un bulletin spécial. Apportez votre carte d'information de l'électeur et une preuve d'identité, et rappelez-vous : votre vote est secret, personne ne peut vous demander pour qui vous avez voté."
      },
      "appearance": {
        "skinTone": "tone-4",
        "outfit": "fleece",
        "hair": "long",
        "hairColor": "black",
        "accessory": "glasses",
        "body": "female",
