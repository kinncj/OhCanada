        0,
        232
      ],
      "behavior": "wander",
      "wanderRadius": 5,
      "questRefs": [],
      "idleDialogue": {
        "en": "Red and white have been Canada's national colours since 1921, but the maple leaf flag itself was first raised only in 1965.",
        "fr": "Le rouge et le blanc sont les couleurs nationales du Canada depuis 1921, mais le drapeau à la feuille d'érable n'a été hissé pour la première fois qu'en 1965."
      },
      "appearance": {
        "skinTone": "tone-3",
        "outfit": "parka",
        "hair": "short",
        "hairColor": "black",
        "accessory": "scarf",
        "body": "male",
