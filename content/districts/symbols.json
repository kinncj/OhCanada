      "position": [
        3,
        0,
        12
      ],
      "behavior": "idle",
      "questRefs": [
        "symbols-intro",
        "symbols-colours-of-canada"
      ],
      "idleDialogue": {
        "en": "Hockey is Canada's official winter sport and lacrosse the summer one. My kids play both, and they'd tell you hockey is the hard one.",
        "fr": "Le hockey est le sport national d'hiver du Canada et la crosse, celui d'été. Mes jeunes jouent aux deux, et ils vous diront que le hockey est le plus dur."
      },
      "appearance": {
        "skinTone": "tone-1",
        "outfit": "hockey",
        "hair": "long",
        "hairColor": "blond",
        "accessory": "toque",
        "body": "female",
