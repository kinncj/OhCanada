    {
      "id": "npc-symbols-3",
      "name": {
        "en": "Walter, Veteran",
        "fr": "Walter, vétéran"
      },
      "position": [
        14,
        0,
        20
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "Every November 11 I pin on a red poppy for the friends who never came home. Remembrance Day marks the end of the First World War in 1918.",
        "fr": "Chaque 11 novembre, j'épingle un coquelicot rouge pour les amis qui ne sont jamais revenus. Le jour du Souvenir marque la fin de la Première Guerre mondiale en 1918."
      },
      "appearance": {
        "skinTone": "tone-2",
        "outfit": "parka",
        "hair": "none",
        "hairColor": "grey",
        "body": "male",
        "age": "elder",
        "outfitStyle": "formal",
        "bottomColor": "#1a1d24",
        "hat": "beret"
      }
    },
    {
      "id": "symbols-hockey-player",
      "name": {
        "en": "Danielle Roy, forward",
        "fr": "Danielle Roy, attaquante"
      },
      "position": [
        10,
        0,
        -44
      ],
      "behavior": "wander",
      "wanderRadius": 5,
      "questRefs": [],
      "idleDialogue": {
        "en": "Hockey is Canada's most popular spectator sport and our national winter sport; lacrosse is the national summer sport. The Stanley Cup was donated by Lord Stanley in 1892, and we still chase it every spring.",
        "fr": "Le hockey est le sport le plus populaire au Canada et notre sport national d'hiver; la crosse est le sport national d'été. La Coupe Stanley a été offerte par lord Stanley en 1892, et on court encore après chaque printemps."
