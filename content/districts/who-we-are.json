  "npcs": [
    {
      "id": "npc-who-we-are-1",
      "name": {
        "en": "Elder Sarah Cardinal",
        "fr": "L'aînée Sarah Cardinal"
      },
      "position": [
        3,
        0,
        12
      ],
      "behavior": "idle",
      "questRefs": [
        "who-we-are-intro",
        "who-we-are-voices-of-the-circle"
      ],
      "idleDialogue": {
        "en": "Canada recognizes three distinct groups of Indigenous peoples: First Nations, Inuit and Métis. Each has its own languages and traditions.",
        "fr": "Le Canada reconnaît trois groupes distincts de peuples autochtones : les Premières Nations, les Inuits et les Métis. Chacun a ses propres langues et traditions."
      },
      "appearance": {
        "skinTone": "tone-4",
        "outfit": "fleece",
        "hair": "long",
        "hairColor": "grey",
        "body": "female",
        "age": "elder",
        "outfitStyle": "casual",
        "bottomColor": "#3b2f2a",
        "hat": "none"
      }
    },
    {
      "id": "npc-who-we-are-2",
      "name": {
        "en": "Nuka, Inuit Carver",
        "fr": "Nuka, sculpteur inuit"
      },
      "position": [
        -10,
        0,
        18
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "In Inuktitut, 'Inuit' means 'the people'. Most of us live in small communities spread across the Arctic.",
        "fr": "En inuktitut, « Inuit » signifie « le peuple ». La plupart d'entre nous vivent dans de petites communautés dispersées dans l'Arctique."
      },
      "appearance": {
        "skinTone": "tone-3",
        "outfit": "parka",
        "hair": "short",
        "hairColor": "black",
        "body": "male",
        "age": "adult",
        "outfitStyle": "parka",
        "bottomColor": "#2b2f3a",
        "hat": "hood"
      }
    },
    {
      "id": "npc-who-we-are-3",
      "name": {
        "en": "Jean-Luc, Acadian Fiddler",
        "fr": "Jean-Luc, violoneux acadien"
      },
      "position": [
        12,
        0,
        20
      ],
      "behavior": "wander",
      "wanderRadius": 4,
      "questRefs": [],
      "idleDialogue": {
        "en": "My ancestors settled the Maritimes starting in 1604. Between 1755 and 1763, most Acadians were deported, yet our culture is still alive.",
        "fr": "Mes ancêtres se sont établis dans les Maritimes à partir de 1604. Entre 1755 et 1763, la plupart des Acadiens ont été déportés, mais notre culture est toujours vivante."
      },
      "appearance": {
        "skinTone": "tone-2",
        "outfit": "plaid",
        "hair": "short",
        "hairColor": "brown",
        "body": "male",
        "age": "adult",
        "outfitStyle": "casual",
        "bottomColor": "#4a3b2e",
        "hat": "beret",
        "beard": true
      }
    },
    {
      "id": "who-we-are-metis-fiddler",
      "name": {
        "en": "Rémi Dumont, Métis fiddler",
        "fr": "Rémi Dumont, violoneux métis"
      },
      "position": [
        18,
        0,
        -8
      ],
      "behavior": "idle",
      "questRefs": [],
      "idleDialogue": {
        "en": "The Métis are a distinct people of mixed Indigenous and European ancestry. Most of us live on the Prairies, and many still speak Michif. This fiddle has played the Red River Jig at more weddings than I can count.",
        "fr": "Les Métis sont un peuple distinct, d'ascendance mixte autochtone et européenne. La plupart d'entre nous vivent dans les Prairies et beaucoup parlent encore le michif. Ce violon a joué la gigue de la rivière Rouge à plus de noces que je ne peux compter."
      },
      "appearance": {
        "skinTone": "tone-4",
        "outfit": "plaid",
        "hair": "short",
        "hairColor": "black",
        "accessory": "scarf",
        "body": "male",
        "age": "adult",
        "outfitStyle": "casual",
