node_modules/

# Anchored to the repository root on purpose. An unanchored `dist/` also matches
# `assets/dist/`, which silently deleted the tracked `assets/dist/.gitkeep` and
# every other skeleton directory ending in one of these names.
/dist/
/coverage/
/playwright-report/
/test-results/
/.vite/

*.log
.DS_Store
.env
.env.*


# Everything scripts/assets.mjs writes into assets/dist is build output: WebP
# atlases and their JSON, standalone WebP, copied .riv artboards and
# manifest.json, all content-hashed and rebuilt from assets/src by every
# `make assets`. Committing them would put a second, staler, content-hashed copy
# of every asset in the repository on every art change - the fastest route there
# is to the 1 GB repository ceiling in CLAUDE.md.
#
# `.gitkeep` stays tracked: vite.config.ts sets `publicDir: 'assets/dist'`, and
# the credit gate in scripts/validate-content.mjs treats `assets/dist` as
# generated (provenance belongs to the source in assets/src, not to a hashed
# derivative), so the directory must exist in a fresh checkout.
#
# This replaces `assets/dist/**/*.tmp`, which named scratch files the packer
# never actually wrote: it packs in memory and writes each output once.
/assets/dist/*
!/assets/dist/.gitkeep

# The cached Discover Canada study guide and its extracted text. Crown copyright:
# we may paraphrase it and must not redistribute it. `content/sources/*.json`
# records the URL, the SHA-256 and the edition so a verifier can re-fetch and
# hash-check the same bytes; the bytes themselves stay out of the repository.
content/sources/*.pdf
content/sources/*.txt
content/sources/*.html
