node_modules/

# Anchored to the repository root on purpose. An unanchored `dist/` also matches
# `assets/dist/`, which silently deleted the tracked `assets/dist/.gitkeep` and
# every other skeleton directory ending in one of these names.
/dist/
/coverage/
/playwright-report/
/test-results/
/.vite/

*.log
.DS_Store
.env
.env.*


# Everything scripts/assets.mjs writes into assets/dist is build output: WebP
# atlases and their JSON, standalone WebP, copied .riv artboards and
# manifest.json, all content-hashed and rebuilt from assets/src by every
# `make assets`. Committing them would put a second, staler, content-hashed copy
# of every asset in the repository on every art change - the fastest route there
# is to the 1 GB repository ceiling in CLAUDE.md.
#
# `.gitkeep` stays tracked: vite.config.ts sets `publicDir: 'assets/dist'`, and
# the credit gate in scripts/validate-content.mjs treats `assets/dist` as
# generated (provenance belongs to the source in assets/src, not to a hashed
# derivative), so the directory must exist in a fresh checkout.
#
# This replaces `assets/dist/**/*.tmp`, which named scratch files the packer
# never actually wrote: it packs in memory and writes each output once.
/assets/dist/*
!/assets/dist/.gitkeep

# The cached Discover Canada study guide and its extracted text. Crown copyright:
# we may paraphrase it and must not redistribute it. `content/sources/*.json`
# records the URL, the SHA-256 and the edition so a verifier can re-fetch and
# hash-check the same bytes; the bytes themselves stay out of the repository.
content/sources/*.pdf
content/sources/*.txt
content/sources/*.html

# ADR-0021: the one place a throwaway probe may live.
#
# A probe that interrogates ajv, sharp or a build script has to import the
# REPOSITORY'S real dependencies -- that is ADR-0014's method -- and Node
# resolves `node_modules` by walking UP from the importing file. A probe under
# /tmp therefore dies with ERR_MODULE_NOT_FOUND, so it lands at the repository
# root instead and breaks `eslint .` for everyone. That happened twice in one
# session before anyone found the cause, and a ban would simply be routed around
# by people who agreed with it (ADR-0009's lesson).
#
# So: a DIRECTORY, not a filename pattern. A pattern like `.tn-*.mjs` would hide
# a file wherever it sat -- an abandoned probe in app/adapters/ would go silently
# unlinted, which is the opposite of localising the mess -- and it would encode a
# naming convention nobody is told, so the next agent writes `probe.mjs` and
# breaks lint anyway. `scratch/` shows up in `ls`, which is what makes the
# convention discoverable rather than buried in a config.
#
# Mirrored in eslint.config.js `ignores`. tsconfig.json needs no entry: its
# `include` is an explicit list, so an unlisted directory is already outside
# `make typecheck`, and adding it would restate a fact and go stale.
#
# Scratch DATA -- fixtures, backups, captured output -- still belongs in the
# agent scratchpad. Only executable probes need to be inside the package.
/scratch/*
!/scratch/.gitkeep
