{
  "name": "truenorth-app",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Portrait-first 2D side-scrolling game that teaches the Canadian citizenship test (Discover Canada).",
  "repository": { "type": "git", "url": "https://github.com/kinncj/OhCanada.git" },
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0 && depcruise app common --config .dependency-cruiser.cjs && npm run check-obligations",
    "check-obligations": "node scripts/check-obligations.mjs",
    "test": "vitest run --coverage && node scripts/coverage-floor.mjs",
    "test:e2e": "scripts/browser-suite-lock.sh playwright test --config tests/e2e/playwright.config.ts",
    "test:perf": "scripts/browser-suite-lock.sh playwright test --config tests/perf/playwright.config.ts",
    "test:a11y": "scripts/browser-suite-lock.sh playwright test --config tests/a11y/playwright.config.ts",
    "validate-content": "node scripts/validate-content.mjs",
    "verify-content": "node scripts/verify-content.mjs",
    "sources": "node scripts/sources.mjs",
    "verify-art": "node scripts/verify-art.mjs",
    "assets": "node scripts/assets.mjs",
    "check-level-payload": "node scripts/check-level-payload.mjs",
    "check-texture-memory": "node scripts/check-texture-memory.mjs"
  },
  "dependencies": {
    "@rive-app/canvas": "2.42.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "howler": "2.2.4",
    "i18next": "26.4.2",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/howler": "2.2.13",
    "@types/node": "26.5.0",
    "@vitest/coverage-v8": "5.0.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "free-tex-packer-core": "0.3.9",
    "globals": "17.12.0",
    "msdf-bmfont-xml": "2.8.0",
    "sharp": "0.35.4",
    "ts-fsrs": "5.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "workbox-build": "7.4.1"
  }
}
